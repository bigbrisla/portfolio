---
/**
 * Static hero visual: a seeded "embedding" scatter with a few clusters and
 * similarity arcs. Rendered at build time, so it is also the no-JS and
 * reduced-motion fallback for the interactive point cloud (milestone 3).
 */
import { seeded, gaussian, dotsPath } from '@/lib/rand';

const rand = seeded('latent-space');
const W = 1200;
const H = 640;
const clusters = [
  { x: 260, y: 220, s: 70, n: 90 },
  { x: 620, y: 420, s: 95, n: 140 },
  { x: 930, y: 190, s: 60, n: 80 },
  { x: 1010, y: 480, s: 50, n: 50 },
];
const points = clusters.flatMap((c, ci) =>
  Array.from({ length: c.n }, () => ({
    x: c.x + gaussian(rand) * c.s,
    y: c.y + gaussian(rand) * c.s * 0.8,
    r: 0.8 + rand() * 1.8,
    c: ci,
  })),
);
const noise = Array.from({ length: 160 }, () => ({
  x: rand() * W,
  y: rand() * H,
  r: 0.6 + rand() * 1.1,
}));
const arcs = [
  { a: clusters[0], b: clusters[1], score: '0.87' },
  { a: clusters[1], b: clusters[2], score: '0.62' },
  { a: clusters[1], b: clusters[3], score: '0.74' },
];
const arcPath = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2 - 80;
  return `M${a.x} ${a.y} Q${mx} ${my} ${b.x} ${b.y}`;
};
---

<svg
  class="hero-static"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <path class="noise" d={dotsPath(noise)} />
  <path class="pts" d={dotsPath(points.filter((p) => p.c !== 1))} />
  <path class="pts hot" d={dotsPath(points.filter((p) => p.c === 1))} />
  <g class="arcs">
    {arcs.map(({ a, b, score }) => (
      <g>
        <path d={arcPath(a, b)} />
        <text x={(a.x + b.x) / 2} y={(a.y + b.y) / 2 - 46}>
          {score}
        </text>
      </g>
    ))}
  </g>
</svg>

<style>
  .hero-static {
    width: 100%;
    height: 100%;
  }
  .noise {
    fill: var(--point);
    opacity: 0.35;
  }
  .pts {
    fill: var(--point);
  }
  .pts.hot {
    fill: var(--signal);
    opacity: 0.85;
  }
  .arcs path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    opacity: 0.7;
  }
  .arcs text {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--ink-muted);
    text-anchor: middle;
  }
  @media (max-width: 720px) {
    .arcs text {
      display: none;
    }
  }
</style>
