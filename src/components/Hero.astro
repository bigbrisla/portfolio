---
import HeroStatic from './HeroStatic.astro';

interface Props {
  copy: { role: string; line: string; ctaWork: string; ctaContact: string; location: string };
}
const { copy } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__visual" aria-hidden="true">
    <HeroStatic />
  </div>
  <canvas class="hero__canvas" data-pc-canvas aria-hidden="true"></canvas>

  <div class="container hero__content">
    <p class="label hero__meta">
      <span class="dot" aria-hidden="true"></span>
      {copy.location} · <span aria-hidden="true">[44.70, 10.63]</span>
    </p>
    <h1 id="hero-title" class="display hero__name" data-pc-title>
      <span data-pc-line="ink">Riccardo</span>
      <em data-pc-line="accent">Bedogni</em>
    </h1>
    <p class="hero__role mono">{copy.role}</p>
    <p class="hero__line">{copy.line}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#work">
        {copy.ctaWork}
      </a>
      <a class="btn" href="#contact">
        {copy.ctaContact}
      </a>
    </div>
  </div>

  <a class="hero__scroll mono" href="#trajectory" aria-hidden="true" tabindex="-1">
    <span></span>
  </a>
</section>

<script>
  import { initPointCloud } from '@/scripts/point-cloud';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initPointCloud(hero);
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 880px);
    display: grid;
    align-items: end;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .hero__visual {
    position: absolute;
    inset: 0;
    opacity: 0.9;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  /* soft scrim so the cloud never competes with the text block */
  .hero__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 52% 62% at 18% 72%,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 80%, transparent) 45%,
      transparent 100%
    );
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero__content {
    position: relative;
    padding-block: var(--s-9) var(--s-8);
  }
  /* above the canvas, except the title which the canvas redraws */
  .hero__content > :not(.hero__name) {
    position: relative;
    z-index: 2;
  }
  .hero__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px var(--signal-soft);
  }
  .hero__name {
    font-size: var(--step-5);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .hero__name > * {
    display: block;
    width: max-content;
  }
  .hero__name em {
    font-style: italic;
    color: var(--signal);
  }
  /* once the canvas draws the name, the text stays for a11y/selection but is invisible */
  /* once the canvas draws the name, the real text stays as a faint ghost under the
     points: still selectable and accessible, and the name reads even mid-scatter */
  :global(.pc-ready) .hero__name {
    color: color-mix(in srgb, var(--ink) 13%, transparent);
  }
  :global(.pc-ready) .hero__name em {
    color: color-mix(in srgb, var(--signal) 16%, transparent);
  }
  .hero__role {
    margin-top: var(--s-5);
    color: var(--ink-muted);
  }
  .hero__line {
    max-width: 34ch;
    margin-top: var(--s-3);
    font-size: var(--step-1);
    line-height: 1.35;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: var(--s-6);
    z-index: 2;
    width: 1px;
    height: 56px;
    background: var(--line);
    overflow: hidden;
  }
  .hero__scroll span {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 40%;
    background: var(--signal);
    animation: drip 2.4s var(--ease) infinite;
  }
  @keyframes drip {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(260%);
    }
  }

  @media (max-width: 720px) {
    .hero__visual::after {
      background: linear-gradient(
        to bottom,
        transparent 0%,
        transparent 38%,
        color-mix(in srgb, var(--bg) 70%, transparent) 62%,
        var(--bg) 100%
      );
    }
    .hero__scroll {
      display: none;
    }
  }
</style>
