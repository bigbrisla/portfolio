---
// Plain button + tiny inline script: no framework needed for a toggle.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button class="theme-toggle" type="button" aria-label={label} data-theme-toggle>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle class="sun" cx="12" cy="12" r="4.5"></circle>
    <g class="rays">
      <circle cx="12" cy="3" r="1"></circle>
      <circle cx="12" cy="21" r="1"></circle>
      <circle cx="3" cy="12" r="1"></circle>
      <circle cx="21" cy="12" r="1"></circle>
      <circle cx="5.6" cy="5.6" r="1"></circle>
      <circle cx="18.4" cy="18.4" r="1"></circle>
      <circle cx="5.6" cy="18.4" r="1"></circle>
      <circle cx="18.4" cy="5.6" r="1"></circle>
    </g>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  function setTheme(next: 'light' | 'dark') {
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable (private mode) */
    }
    document
      .querySelectorAll('[data-theme-toggle]')
      .forEach((b) => b.setAttribute('aria-pressed', String(next === 'dark')));
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.setAttribute('aria-pressed', String(current() === 'dark'));
    btn.addEventListener('click', () => setTheme(current() === 'dark' ? 'light' : 'dark'));
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .theme-toggle:hover {
    border-color: var(--signal);
  }
  svg {
    fill: var(--ink);
    transition: transform var(--dur) var(--ease);
  }
  .rays {
    transform-origin: center;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  :global([data-theme='dark']) .rays {
    opacity: 0;
    transform: scale(0.6);
  }
  :global([data-theme='dark']) svg {
    transform: rotate(-30deg);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .rays {
      opacity: 0;
      transform: scale(0.6);
    }
  }
</style>
