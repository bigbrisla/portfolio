---
import Hero from './Hero.astro';
import SectionHeader from './SectionHeader.astro';
import Trajectory from './Trajectory.astro';
import Work from './Work.astro';
import Thesis from './Thesis.astro';
import Method from './Method.astro';
import Toolkit from './Toolkit.astro';
import Contact from './Contact.astro';
import { getLocale, useTranslations } from '@/i18n/utils';
import { getSiteCopy } from '@/lib/projects';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const copy = await getSiteCopy(locale);
const s = t.sections;
---

<Hero copy={copy.hero} />

<section id="trajectory" class="section container" aria-labelledby="trajectory-title">
  <SectionHeader id="trajectory" index={s.trajectory.index} title={s.trajectory.title} />
  <Trajectory copy={copy.trajectory} />
</section>

<section id="work" class="section container" aria-labelledby="work-title">
  <SectionHeader id="work" index={s.work.index} title={s.work.title} />
  <Work locale={locale} copy={copy.work} />
</section>

<section id="thesis" class="section container" aria-labelledby="thesis-title">
  <SectionHeader id="thesis" index={s.thesis.index} title={s.thesis.title} />
  <Thesis locale={locale} copy={copy.thesis} />
</section>

<section id="method" class="section container" aria-labelledby="method-title">
  <SectionHeader id="method" index={s.method.index} title={s.method.title} />
  <Method copy={copy.method} />
</section>

<section id="toolkit" class="section container" aria-labelledby="toolkit-title">
  <SectionHeader id="toolkit" index={s.toolkit.index} title={s.toolkit.title} />
  <Toolkit copy={copy.toolkit} />
</section>

<section id="contact" class="section container" aria-labelledby="contact-title">
  <SectionHeader id="contact" index={s.contact.index} title={s.contact.title} />
  <Contact copy={copy.contact} />
</section>
