---
import ThemeToggle from './ThemeToggle.astro';
import { getLocale, useTranslations, alternatePath, localizedPath } from '@/i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const other = locale === 'en' ? 'it' : 'en';
const home = localizedPath('/', locale);
const sections = ['work', 'thesis', 'method', 'contact'] as const;
---

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href={home} aria-label={`Riccardo Bedogni — ${t.nav.home}`}>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <circle cx="4" cy="6" r="1.8"></circle>
        <circle cx="13" cy="4" r="1.2"></circle>
        <circle cx="16" cy="11" r="2.2"></circle>
        <circle cx="7" cy="15" r="1.4"></circle>
        <path d="M4 6 16 11 7 15"></path>
      </svg>
      <span>R. Bedogni</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__links">
        {sections.map((id) => (
          <li>
            <a href={`${home}#${id}`}>{t.nav[id]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__actions">
      <button class="nav__search" type="button" data-palette-open aria-label={t.palette.open}>
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5"></circle>
          <path d="m13 13 4 4"></path>
        </svg>
        <span class="nav__search-label">{t.nav.search}</span>
        <kbd class="mono" aria-hidden="true">
          ⌘K
        </kbd>
        <span class="nav__menu-label">{t.nav.menu}</span>
      </button>
      <a
        class="nav__lang mono"
        href={alternatePath(Astro.url, other)}
        hreflang={other}
        lang={other}
        aria-label={t.lang.switch}
      >
        {t.lang.short}
      </a>
      <ThemeToggle label={t.theme.toggle} />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: 3.75rem;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav__brand svg {
    fill: var(--signal);
  }
  .nav__brand path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 0.8;
    opacity: 0.6;
  }
  nav {
    margin-left: auto;
  }
  .nav__links {
    display: flex;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    font-size: 0.9rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .nav__search {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 2.5rem;
    padding: 0 var(--s-3) 0 var(--s-4);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--ink-muted);
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .nav__search:hover {
    border-color: var(--signal);
    color: var(--ink);
  }
  .nav__search svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .nav__search kbd {
    padding: 0 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-size: 0.7rem;
  }
  .nav__menu-label {
    display: none;
  }
  .nav__lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.75rem;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .nav__lang:hover {
    border-color: var(--signal);
  }

  @media (max-width: 980px) {
    .nav__search-label,
    .nav__search kbd {
      display: none;
    }
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
    .nav__menu-label {
      display: inline;
    }
    .nav__actions {
      margin-left: auto;
    }
  }
</style>
