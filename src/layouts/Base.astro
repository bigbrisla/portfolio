---
import '@/styles/base.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { getLocale, useTranslations, alternatePath } from '@/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { title = t.meta.title, description = t.meta.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altEn = new URL(alternatePath(Astro.url, 'en'), Astro.site);
const altIt = new URL(alternatePath(Astro.url, 'it'), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="it" href={altIt} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <!-- Set the theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.nav.skip}
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
