---
import '@/styles/base.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Palette from '@/components/Palette.astro';
// preload the display face: it carries the name and every heading
import instrumentSerif from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import { getLocale, useTranslations, alternatePath } from '@/i18n/utils';
import { LINKS, PERSON } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** path of the Open Graph image, e.g. /og/en/rag-ai-act.png */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** emit the Person JSON-LD (home pages) */
  person?: boolean;
}

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const {
  title = t.meta.title,
  description = t.meta.description,
  noindex = false,
  ogImage = `/og/${locale}.png`,
  ogType = 'website',
  person = false,
} = Astro.props;
const ogUrl = new URL(ogImage, Astro.site);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PERSON.name,
  url: new URL(locale === 'it' ? '/it/' : '/', Astro.site).href,
  image: ogUrl.href,
  jobTitle: PERSON.jobTitle,
  description: t.meta.personDesc,
  email: `mailto:${LINKS.email}`,
  worksFor: { '@type': 'Organization', name: PERSON.employer },
  affiliation: { '@type': 'CollegeOrUniversity', name: PERSON.university },
  address: { '@type': 'PostalAddress', addressLocality: 'Reggio Emilia', addressCountry: 'IT' },
  sameAs: [LINKS.linkedin, LINKS.github],
  knowsAbout: [
    'Machine learning',
    'Retrieval-augmented generation',
    'Schema matching',
    'Data integration',
    'Computer vision',
    'Python',
    'Vue.js',
  ],
};
const canonical = new URL(Astro.url.pathname, Astro.site);
const altEn = new URL(alternatePath(Astro.url, 'en'), Astro.site);
const altIt = new URL(alternatePath(Astro.url, 'it'), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="it" href={altIt} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Riccardo Bedogni" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locale === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'it' ? 'en_US' : 'it_IT'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="author" content="Riccardo Bedogni" />
    {person && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    <link rel="preload" href={instrumentSerif} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <!-- Set the theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          /* storage unavailable */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.nav.skip}
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Palette />
    <script>
      import { initReveal } from '@/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
